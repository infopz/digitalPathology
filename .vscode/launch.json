        {
            "name": "Heatmap Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/aiflopp/plot_attention_heatmap.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["--bag-id", "RE_I_25_18280_1_C"]
        }
    ]
}